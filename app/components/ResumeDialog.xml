<?xml version="1.0" encoding="utf-8" ?>
<!-- "Pick up where you left off?" with two buttons. Handles its own Up/Down/OK/Back
     while it has focus and reports the answer in "choice": resume, restart or cancel. -->
<component name="ResumeDialog" extends="Group">
    <interface>
        <field id="title" type="string" onChange="onTitle" />
        <field id="resumeAt" type="integer" onChange="onResumeAt" alwaysNotify="true" />
        <field id="choice" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="Util.brs" />
    <script type="text/brightscript" uri="ResumeDialog.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x2B2B2AFF" opacity="0.9" />
        <Rectangle translation="[460,270]" width="1000" height="540" color="0x19335EFF" />
        <Label translation="[524,326]" width="872" color="0xFFFFFFFF" text="Pick up where you left off?">
            <Font role="font" uri="pkg:/fonts/PlayfairDisplay-BoldItalic.ttf" size="52" />
        </Label>
        <Label id="itemTitle" translation="[524,410]" width="872" color="0xEBEDE8FF">
            <Font role="font" uri="pkg:/fonts/Montserrat-Medium.ttf" size="32" />
        </Label>

        <Rectangle id="button0" translation="[524,500]" width="872" height="88" color="0x00A7DDFF" />
        <Label id="label0" translation="[564,500]" width="792" height="88" vertAlign="center" color="0x19335EFF">
            <Font role="font" uri="pkg:/fonts/Montserrat-Bold.ttf" size="32" />
        </Label>
        <Rectangle id="button1" translation="[524,612]" width="872" height="88" color="0x4E4F4DFF" />
        <Label id="label1" translation="[564,612]" width="792" height="88" vertAlign="center" color="0xFFFFFFFF" text="Start from the beginning">
            <Font role="font" uri="pkg:/fonts/Montserrat-Bold.ttf" size="32" />
        </Label>
        <Label translation="[524,730]" width="872" color="0xC0C2BEFF" text="Back to cancel">
            <Font role="font" uri="pkg:/fonts/Montserrat-Regular.ttf" size="26" />
        </Label>
    </children>
</component>
