<?xml version="1.0" encoding="utf-8" ?>
<!-- The controls drawn over a playing video: title, date, progress bar, times and
     button hints. MainScene sets the fields; this only draws. -->
<component name="PlayerOverlay" extends="Group">
    <interface>
        <field id="title" type="string" onChange="onText" />
        <field id="subtitle" type="string" onChange="onText" />
        <field id="isLive" type="boolean" onChange="onMode" />
        <field id="paused" type="boolean" onChange="onMode" />
        <field id="position" type="float" onChange="onProgress" />
        <field id="duration" type="float" onChange="onProgress" />
        <!-- Holding Left/Right: shows where she'll land, in a bubble over the playhead -->
        <field id="scrubbing" type="boolean" onChange="onMode" />
    </interface>
    <script type="text/brightscript" uri="Util.brs" />
    <script type="text/brightscript" uri="PlayerOverlay.brs" />
    <children>
        <Poster id="shade" translation="[0,560]" width="1920" height="520" uri="pkg:/images/overlay_shade.png" />

        <Group id="livePill" translation="[96,746]">
            <Rectangle id="livePillBg" width="200" height="52" color="0x9C2D40FF" />
            <Rectangle translation="[22,19]" width="14" height="14" color="0xFFFFFFFF" />
            <Label id="livePillText" translation="[50,0]" height="52" vertAlign="center" text="LIVE NOW" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/fonts/Montserrat-Bold.ttf" size="24" />
            </Label>
        </Group>

        <Label id="title" translation="[96,814]" width="1728" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/PlayfairDisplay-BoldItalic.ttf" size="56" />
        </Label>
        <Label id="subtitle" translation="[96,894]" width="1728" color="0xC0C2BEFF">
            <Font role="font" uri="pkg:/fonts/Montserrat-Regular.ttf" size="30" />
        </Label>

        <Group id="bar" translation="[96,956]">
            <Rectangle id="track" width="1728" height="8" color="0x727370FF" />
            <Rectangle id="fill" width="0" height="8" color="0x00A7DDFF" />
            <Rectangle id="knob" translation="[-10,-6]" width="20" height="20" color="0xFFFFFFFF" />
            <Group id="bubble" translation="[0,-72]" visible="false">
                <Rectangle width="160" height="52" color="0xFFFFFFFF" />
                <Label id="bubbleText" width="160" height="52" horizAlign="center" vertAlign="center" color="0x2B2B2AFF">
                    <Font role="font" uri="pkg:/fonts/Montserrat-Bold.ttf" size="30" />
                </Label>
            </Group>
        </Group>
        <Label id="elapsed" translation="[96,982]" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/Montserrat-Medium.ttf" size="28" />
        </Label>
        <Label id="total" translation="[1324,982]" width="500" horizAlign="right" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/Montserrat-Medium.ttf" size="28" />
        </Label>
        <Label id="hint" translation="[0,984]" width="1920" horizAlign="center" color="0xC0C2BEFF">
            <Font role="font" uri="pkg:/fonts/Montserrat-Medium.ttf" size="26" />
        </Label>

        <!-- Big "play" symbol in the middle while paused -->
        <Poster id="pausedIcon" translation="[880,380]" width="160" height="160" uri="pkg:/images/icon_paused.png" visible="false" />
    </children>
</component>
