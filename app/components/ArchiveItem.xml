<?xml version="1.0" encoding="utf-8" ?>
<!-- One past service in a row on the home screen: thumbnail, progress bar, title, date.
     Reads title, description, HDPosterUrl and progress (0-1) from its ContentNode.
     The tile is 416x348: the thumbnail sits 8px in, so the focus outline around it
     stays inside the tile (RowList cuts off anything drawn outside a tile). -->
<component name="ArchiveItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="focusPercent" type="float" onChange="onFocusChange" />
        <field id="rowListHasFocus" type="boolean" onChange="onFocusChange" />
    </interface>
    <script type="text/brightscript" uri="ArchiveItem.brs" />
    <children>
        <!-- Sky focus outline around the thumbnail -->
        <Rectangle id="focusRing" width="416" height="241" color="0x00A7DDFF" opacity="0" />
        <Rectangle id="thumbBg" translation="[8,8]" width="400" height="225" color="0x4E4F4DFF" />
        <Poster id="placeholder" translation="[162,75]" width="92" height="91" uri="pkg:/images/logo_mark_small.png" />
        <Poster id="thumb" translation="[8,8]" width="400" height="225" loadDisplayMode="scaleToZoom" />
        <!-- How much has been watched -->
        <Rectangle id="progressTrack" translation="[24,205]" width="368" height="8" color="0x2B2B2AFF" visible="false" />
        <Rectangle id="progressFill" translation="[24,205]" width="0" height="8" color="0x00A7DDFF" visible="false" />
        <Label id="title" translation="[8,256]" width="400" color="0xEBEDE8FF">
            <Font role="font" uri="pkg:/fonts/Montserrat-Medium.ttf" size="30" />
        </Label>
        <Label id="subtitle" translation="[8,300]" width="400" color="0xC0C2BEFF">
            <Font role="font" uri="pkg:/fonts/Montserrat-Regular.ttf" size="26" />
        </Label>
    </children>
</component>
