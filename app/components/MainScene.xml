<?xml version="1.0" encoding="utf-8" ?>
<!-- Colors come from The Chapel branding guide:
     Charcoal 2B2B2A, Navy 19335E, Sky 00A7DD, White, Cloud EBEDE8, Silver C0C2BE,
     Smoke 727370, Graphite 4E4F4D, Crimson 9C2D40.
     Fonts: Montserrat (text), Playfair Display Bold Italic (headlines). -->
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/source/AppConfig.brs" />
    <script type="text/brightscript" uri="Util.brs" />
    <script type="text/brightscript" uri="Progress.brs" />
    <script type="text/brightscript" uri="MainScene.brs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" color="0x2B2B2AFF" />

        <Group id="home">
            <!-- Everything below the header; slides up to show the rows -->
            <Group id="scroller">
                <!-- Live card -->
                <Group id="hero" translation="[96,176]">
                    <Rectangle id="heroRing" translation="[-8,-8]" width="1744" height="416" color="0x00A7DDFF" />
                    <Rectangle id="heroCard" width="1728" height="400" color="0x19335EFF" />
                    <Group id="pill" translation="[64,56]">
                        <Rectangle id="pillBg" width="200" height="52" color="0x4E4F4DFF" />
                        <Rectangle id="pillDot" translation="[22,19]" width="14" height="14" color="0xFFFFFFFF" />
                        <Label id="pillText" translation="[50,0]" height="52" vertAlign="center" color="0xFFFFFFFF">
                            <Font role="font" uri="pkg:/fonts/Montserrat-Bold.ttf" size="24" />
                        </Label>
                    </Group>
                    <Label id="heroHeadline" translation="[64,128]" width="1160" color="0xFFFFFFFF">
                        <Font role="font" uri="pkg:/fonts/PlayfairDisplay-BoldItalic.ttf" size="76" />
                    </Label>
                    <Label id="heroBody" translation="[64,232]" width="1160" wrap="true" maxLines="2" lineSpacing="6" color="0xEBEDE8FF">
                        <Font role="font" uri="pkg:/fonts/Montserrat-Regular.ttf" size="34" />
                    </Label>
                    <Label id="heroHint" translation="[64,326]" width="1160" color="0x00A7DDFF">
                        <Font role="font" uri="pkg:/fonts/Montserrat-Bold.ttf" size="26" />
                    </Label>
                    <Poster id="heroMark" translation="[1402,70]" width="262" height="260" uri="pkg:/images/logo_mark.png" />
                </Group>

                <!-- Services she started -->
                <Group id="continueSection" translation="[96,622]" visible="false">
                    <Label text="CONTINUE WATCHING" color="0xFFFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Montserrat-Bold.ttf" size="28" />
                    </Label>
                    <RowList
                        id="continueRow"
                        translation="[0,62]"
                        itemComponentName="ArchiveItem"
                        numRows="1"
                        itemSize="[1728,340]"
                        rowItemSize="[[400,340]]"
                        rowItemSpacing="[[32,0]]"
                        showRowLabel="[false]"
                        drawFocusFeedback="false"
                        rowFocusAnimationStyle="floatingFocus" />
                </Group>

                <!-- Past services -->
                <Group id="archiveSection" translation="[96,622]">
                    <Label text="SERMON ARCHIVE" color="0xFFFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Montserrat-Bold.ttf" size="28" />
                    </Label>
                    <Label id="archiveMessage" translation="[0,78]" width="1728" color="0xC0C2BEFF">
                        <Font role="font" uri="pkg:/fonts/Montserrat-Regular.ttf" size="32" />
                    </Label>
                    <RowList
                        id="archiveRow"
                        translation="[0,62]"
                        itemComponentName="ArchiveItem"
                        numRows="1"
                        itemSize="[1728,340]"
                        rowItemSize="[[400,340]]"
                        rowItemSpacing="[[32,0]]"
                        showRowLabel="[false]"
                        drawFocusFeedback="false"
                        rowFocusAnimationStyle="floatingFocus"
                        visible="false" />
                </Group>
            </Group>

            <!-- Header, drawn over the content as it scrolls up -->
            <Rectangle id="headerBg" width="1920" height="156" color="0x2B2B2AFF" />
            <Poster id="headerLogo" translation="[96,60]" width="307" height="72" uri="pkg:/images/logo_header.png" />
            <Label id="clock" translation="[1224,66]" width="600" horizAlign="right" color="0xC0C2BEFF">
                <Font role="font" uri="pkg:/fonts/Montserrat-Medium.ttf" size="32" />
            </Label>
            <Label id="statusCode" translation="[1224,114]" width="600" horizAlign="right" color="0xC0C2BEFF">
                <Font role="font" uri="pkg:/fonts/Montserrat-Regular.ttf" size="22" />
            </Label>
        </Group>

        <!-- Video with the app's own controls (Roku's built-in ones are turned off) -->
        <Video id="video" width="1920" height="1080" visible="false" enableUI="false" enableTrickPlay="false" notificationInterval="1" />
        <PlayerOverlay id="overlay" visible="false" />

        <!-- Shown while a video link is being fetched -->
        <Group id="loading" visible="false">
            <Rectangle width="1920" height="1080" color="0x2B2B2AFF" />
            <Poster translation="[829,250]" width="262" height="260" uri="pkg:/images/logo_mark.png" />
            <Label id="loadingTitle" translation="[0,570]" width="1920" horizAlign="center" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/fonts/PlayfairDisplay-BoldItalic.ttf" size="60" />
            </Label>
            <Label id="loadingDetail" translation="[160,670]" width="1600" horizAlign="center" color="0xC0C2BEFF">
                <Font role="font" uri="pkg:/fonts/Montserrat-Regular.ttf" size="34" />
            </Label>
        </Group>

        <Poster id="spinner" translation="[912,492]" width="96" height="96" scaleRotateCenter="[48,48]" uri="pkg:/images/spinner.png" visible="false" />

        <ResumeDialog id="dialog" visible="false" />

        <Animation id="scrollAnim" duration="0.3" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="scrollInterp" key="[0.0, 1.0]" keyValue="[[0,0],[0,0]]" fieldToInterp="scroller.translation" />
        </Animation>
        <Animation id="spinAnim" duration="1" repeat="true" easeFunction="linear">
            <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, -6.2832]" fieldToInterp="spinner.rotation" />
        </Animation>

        <Timer id="pollTimer" repeat="true" />
        <Timer id="clockTimer" repeat="true" duration="15" />
        <Timer id="overlayTimer" repeat="false" duration="5" />
    </children>
</component>
